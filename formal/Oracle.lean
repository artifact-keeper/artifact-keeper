import ArtifactKeeper.Oracle.QuarantineDownloadGate

/-!
`ak-oracle`: the formal models as an executable, so Rust tests can be checked
against the models' own answers instead of a hand-written copy of them.

  ak-oracle emit <model>   print the vector file for a model: one
                           `<input> => <answer>` line per case

The vector files under `vectors/` are generated by this command and checked
in; CI regenerates them and fails on any difference. See README.md, "Oracle
vectors".
-/
open ArtifactKeeper.Oracle

/-- Each model: its name, the answer function, and the cases to emit. -/
def models : List (String × (List String → String) × List String) :=
  [("quarantine_download_gate", QuarantineDownloadGate.answer, QuarantineDownloadGate.cases)]

def main (args : List String) : IO UInt32 := do
  let stdout ← IO.getStdout
  match args with
  | ["emit", m] =>
    match models.lookup m with
    | some (answer, cases) =>
      stdout.putStrLn s!"# GENERATED by `lake exe ak-oracle emit {m}` in formal/. Do not edit: CI regenerates it and fails on any difference."
      stdout.putStrLn s!"# cases: {cases.length}"
      for c in cases do
        stdout.putStrLn s!"{c} => {answer (c.splitOn " ")}"
      return 0
    | none => IO.eprintln s!"ak-oracle: no model {m}"; return 2
  | _ => IO.eprintln "usage: ak-oracle emit <model>"; return 2

# /etc/ak-mcp-introspector.env (mode 0644 is fine: no secrets). #5253.
AK_URL=https://ak.example.com
# The mcp:introspect token is NOT set here: put it in
# /etc/ak-mcp-introspector/token (mode 0600, owner root), which the unit
# passes as standard input. A value in the environment would be readable in
# /proc/<pid>/environ by any process of the worker's user.
# Unique per worker: leftover guests and guest networks are reaped by this
# id, so two workers on one host with the same id would remove each other's.
AK_MCP_INTROSPECTOR_ID=sandbox-host-1
XDG_RUNTIME_DIR=/run/user/1500
AK_MCP_SANDBOX_ENGINE=podman
AK_MCP_SANDBOX_RUNTIME=runsc
# The AK forwarder container (compose.sandbox-network.yaml). Each npm or
# PyPI guest gets an internal network of its own that only this container
# joins, under the host of the backend's public base URL (#5447). Do not
# set AK_MCP_SANDBOX_NETWORK: with it set the worker refuses to start.
AK_MCP_SANDBOX_GATEWAY=ak-gateway
AK_MCP_SANDBOX_MEMORY=1g
AK_MCP_SANDBOX_CPUS=1
# Mirrored through an AK OCI repository and pinned by digest.
AK_MCP_SANDBOX_NODE_IMAGE=ak.example.com/docker-local/library/node@sha256:<digest>
AK_MCP_SANDBOX_PYTHON_IMAGE=ak.example.com/docker-local/astral-sh/uv@sha256:<digest>

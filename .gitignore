# Build artifacts
*.so
*.dylib
*.dll

# Compiled Go binary from a local `go build` in the scanner-adapter module.
# NEVER commit this (#3341): anything under docker/scanner-adapter/ counts as
# "scanner-adapter sources" to the publish job's identity check, so a stray
# build artifact invalidates the published version tag and forces a VERSION
# bump with no source change. The image compiles the adapter from source
# (docker/Dockerfile.scanner-adapter stage 1); nothing consumes this file.
docker/scanner-adapter/scanner-adapter

# Generated gRPC/protobuf files (regenerated by build.rs)
backend/src/grpc/generated/*.rs
backend/src/grpc/generated/*.bin


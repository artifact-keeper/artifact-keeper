# =============================================================================
# Artifact Keeper — in-house Trivy scanner adapter (multi-arch)
# =============================================================================
# A small AK-owned Go service implementing the Harbor Pluggable Scanner API v1
# (issue #2091). The backend (TRIVY_ADAPTER_URL) posts a scan request; the
# adapter execs the bundled trivy CLI against the requested image in the AK
# registry and serves the resulting vulnerability report in the Harbor format
# the backend consumes. Trivy is NOT in the backend image (#2059) — it lives
# here.
#
# Build (buildx resolves $TARGETPLATFORM per requested arch):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.scanner-adapter -t artifact-keeper-scanner-adapter:dev .
# Context is the repo root; the Go module lives at docker/scanner-adapter.

# ---------- Stage 1: cross-compile the Go adapter ----------
# Pinned to the BUILDPLATFORM so the toolchain runs natively and cross-compiles
# to the requested TARGET arch (fast, no emulation for the compile step).
# Go 1.26 toolchain: the adapter is stdlib-only, so every Go CVE reported
# against the compiled binary is a stdlib CVE baked in by the builder
# toolchain. The floating `1.26` tag is deliberate — it always resolves to the
# newest patch, which is what a security rebuild wants. Current floor is
# **1.26.6**, not the 1.26.5 this comment used to name: the 2026-08 batch
# (CVE-2026-33818/-56853/-56858/-56859/-56860/-56862, plus -39821/-46600)
# needs 1.26.6, and that is the batch that blocked publishing in #3352.
# Verified 2026-08-16: this image's `usr/local/bin/scanner-adapter` reports
# stdlib v1.26.6 and scans clean. The go.mod `go` directive stays at the
# minimum language version. See issues #2391 and #3352.
#
# The asymmetry with docker/Dockerfile.backend{,.alpine} is now closed. Those
# build grype on the same floating tag and assert a `GO_MIN_PATCH` floor; the
# comment here used to say to copy that assertion "if this adapter ever fails
# a scan on the same class". That condition was met: release/1.7.x's adapter
# binary (1.2.3) carries 8 Go-stdlib HIGHs, because a floating tag is only as
# good as the last rebuild and that build predates go1.26.6. A floating tag
# alone is a hope, not a guarantee — the floor below turns a lagging mirror or
# a stale builder cache into a loud build failure instead of a silently
# vulnerable stdlib. Raise GO_MIN_PATCH in lockstep with the backend
# Dockerfiles when a new Go stdlib advisory lands.
#
# 1.26.6 -> 1.27.2 on 2026-10-10. Two reasons, and the first is the one that
# matters for next time. (1) The floor had gone INERT: #3579 moved the
# FROM from `golang:1.26-alpine` to `golang:1.27-alpine` and left the floor
# on 1.26.6, and the check is a `sort -V`, so every 1.27.x passed it and no
# lagging mirror could fail it. That is the exact bug #3655 fixed in the backend
# Dockerfiles ("keep the floor on the newest patch of whatever minor the FROM
# line names, or this check goes inert again"); this file missed that fix.
# The "Go 1.26 toolchain" and "floating `1.26` tag" wording above is from
# before #3579 as well: the FROM floats on 1.27. (2) go1.27.2 is Go's
# 2026-10 security release (CVE-2026-78667 net/http, CVE-2026-78669 HTTP/2,
# CVE-2026-97031 crypto/tls, all HIGH), raised in lockstep with the backend.
# The adapter binary itself scanned CLEAN in the run that failed on those
# CVEs (main, a8fd2b47, run 38087035953), because the floating FROM had
# already served go1.27.2; the floor makes that a guarantee rather than a
# coincidence of build timing. The adapter is still stdlib-only, so there is
# no golang.org/x/net in it to bump: its go.mod has no require block and no
# go.sum, and adding x/net would add a dependency nothing imports (`go mod
# tidy` removes it again). The x/net findings in this image are in the
# bundled trivy, below.
#
# 1.27.2 -> 1.27.3 on 2026-10-21, for CVE-2026-111943 (HIGH) against stdlib
# v1.27.2. Found not by a red publish but by the pinned-base-image watch
# (#4852) -- which is the whole point of that workflow, since a stdlib CVE in
# the ADAPTER binary is ours to fix here while one in the bundled trivy is
# fixed in artifact-keeper/trivy and reached by moving the digest below. Both
# halves are in this change. Same rule as #3655: the floor stays on the newest
# patch of the minor the floating FROM names, never on the minimum go.mod
# permits. CVE-2026-111943 is also fixed in go1.26.10, which is irrelevant
# here -- this binary is built on 1.27.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build

ARG TARGETOS
ARG TARGETARCH
ARG GO_MIN_PATCH=1.27.3

RUN set -eu; \
    have="$(go env GOVERSION | sed 's/^go//')"; \
    oldest="$(printf '%s\n%s\n' "${have}" "${GO_MIN_PATCH}" | sort -V | head -n1)"; \
    if [ "${have}" != "${GO_MIN_PATCH}" ] && [ "${oldest}" != "${GO_MIN_PATCH}" ]; then \
      echo "ERROR: Go toolchain go${have} is older than the required go${GO_MIN_PATCH}." >&2; \
      echo "       Building the scanner adapter on it would ship known-vulnerable stdlib (#3352)." >&2; \
      exit 1; \
    fi; \
    echo "scanner-adapter build: go${have} satisfies the go${GO_MIN_PATCH} floor"

WORKDIR /src

# stdlib-only module: copying go.mod is enough for the build cache; there are no
# third-party dependencies to download.
COPY docker/scanner-adapter/go.mod ./
COPY docker/scanner-adapter/*.go ./

# CGO disabled for a fully static binary; -trimpath + -s -w for a small,
# reproducible artifact.
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/scanner-adapter .

# ---------- Stage 2: pull the matching trivy binary ----------
# Our own build of upstream trivy v0.76.0 (artifact-keeper/trivy): the same
# upstream source tag, built with our pinned Go toolchain plus the documented
# dependency overrides in that repo's overrides.yaml.
#
# What the 0.73.0-r2 -> 0.74.0-r1 rebuild fixes: the 0.73.0 binary was compiled
# on go1.26.5 and carried 10 HIGHs — 8 Go-stdlib (CVE-2026-33818/-39821/
# -46600/-56853/-56858/-56859/-56860/-56862) plus golang.org/x/mod
# CVE-2026-56864/-56865. Upstream v0.74.0 is built here on go1.26.7 and picks
# up x/mod v0.40.0, so all 10 clear at the source. Note the x/mod pair is the
# same class #3469 addresses for grype in docker/Dockerfile.backend{,.alpine};
# both had to move before Docker Publish could go green.
#
# The two dependency overrides that motivated the earlier r-builds:
#
#   oras.land/oras-go/v2        v2.6.1  -> v2.6.2   (CVE-2026-50163)
#   github.com/go-git/go-git/v5 v5.19.1 -> v5.19.2  (CVE-2026-71556 HIGH,
#                                                    CVE-2026-71557)
#
# In BOTH cases upstream merged the bump on main and had not released it, so
# no upstream tag carried the fix. That is the whole reason this image is
# ours. Leaving this on ghcr.io/aquasecurity/trivy fails the Docker Publish
# security gate, which skips every multi-arch manifest and blocks the release
# chain.
#
# Note that a suppression would have been *permitted* here by /.trivyignore's
# own rule ("only vendored-scanner-binary CVEs that have no fixed tool release
# are listed") — no fixed trivy release exists. It is still the wrong answer:
# a fixed *dependency* exists, we can build against it, and an auditable
# override that assert-buildinfo.sh proves is linked into the shipped binary
# is a stronger claim than a comment saying we think the path is unreachable.
# Suppress when there is no fix. Override when there is one and only the
# packaging is missing.
#
# Worth remembering: upstream 0.73.0 scanned clean when #3123 landed, and our
# own v0.73.0-r1 scanned clean when it was published on 2026-08-07 and went red
# on 2026-08-13 (#3307) without a byte changing — the go-git advisory was
# published against a dependency it already shipped. 0.73.0-r2 then went red
# the same way. A clean scan at merge time does not stay clean, which is why
# the source repo rebuilds and re-gates on a schedule rather than trusting a
# one-time result — and why the digest below will need moving again.
#
# 0.74.0-r2 -> 0.74.0-r3 (#3790) is the grpc override moving one patch
# further, v1.83.1 -> v1.83.2: CVE-2026-84445 (HIGH, gRPC-Go xDS servers crash
# on a request carrying neither `:authority` nor `Host`) was published on
# 2026-09-08 against the very version r2 had just moved to, and failed the
# gate on every main build from 2026-09-09 with no byte of this repo changing
# — the "went red without a byte changing" story below, told a third time.
# Upstream v0.74.0 is still the newest trivy release and still pins v1.82.1,
# so the override stays an override (artifact-keeper/trivy#14); the backend's
# grype carries the same bump in Dockerfile.backend{,.alpine} (#3792).
#
# 0.74.0-r3 -> 0.74.0-r4 (2026-10-10) is Go's October security release, and
# the first r-build that moves the toolchain and an override together. The r3
# binary was compiled on go1.26.7 with golang.org/x/net v0.58.0 and failed
# the gate on four HIGHs: CVE-2026-78669 against x/net (fixed in v0.60.0) and
# CVE-2026-78667 / -78669 / -97031 against the stdlib (fixed in go1.26.9 /
# go1.27.2). r4 builds on go1.26.9 and overrides x/net to v0.60.0, plus the
# six golang.org/x modules MVS moves with it, all at the versions upstream
# v0.75.0 already ships. Upstream has not bumped x/net anywhere yet, so that
# entry is a declared exception to the trivy repo's "upstream already made
# the bump" rule, and it says so in overrides.yaml. The backend's grype and
# buildctl carry the same x/net override in docker/Dockerfile.backend.
#
# 0.74.0-r4 -> 0.74.0-r5 (2026-10-17, #4713) is a dependency override alone,
# no toolchain move: CVE-2026-95837 (HIGH, containerd's CRI checkpoint restore
# bypasses the destination security context) was published against
# github.com/containerd/containerd/v2 v2.3.3, which the r4 binary links for
# trivy's containerd image source, and failed the gate on every main build
# from 2026-10-17 with no byte of this repo changing. Upstream's fix is
# v2.4.1 in trivy 0.75.0 and 0.76.0, and the trivy repo's policy would be to
# bump TRIVY_VERSION to one of those; it cannot, because this adapter's
# checkTrivyServer (remote.go) requires the bundled client and the trivy
# server sidecar to report the same version, and the sidecar is pinned at
# 0.74.0 in the compose files, the workflows and the chart. So r5 takes the
# containerd patch-line fix (v2.3.4, plus the k8s.io/client-go and
# k8s.io/component-base v0.36.3 that MVS moves with it) as a declared
# exception in that repo's overrides.yaml (artifact-keeper/trivy#17). The
# coordinated client+server move to 0.76.0, which empties that override list,
# is #4712. VERSION moves 1.4.1 -> 1.4.2 because this file is part of the
# adapter's versioned source set (RELEASING.md step 5).
#
# 0.74.0-r5 -> 0.76.0-r1 (#4712) is that coordinated move: the bundled client
# and the trivy server sidecar go to 0.76.0 in the same change, because
# checkTrivyServer and clientModeProvenance (remote.go) refuse a server that
# reports a different release than this binary. The sidecar pin moves in
# docker-compose{,.local-dev,.test}.yml and in the docker-publish,
# scheduled-container-scan and scheduled-base-image-watch workflows; the Helm
# chart's trivy.image.tag moves in artifact-keeper-iac. Upstream v0.76.0
# (531360e5) pins every module the r-builds were overriding at or above the
# override version (grpc v1.84.0, golang.org/x/net v0.60.0, containerd/v2
# v2.4.1 and the k8s.io 0.37 line with it), so that repo's overrides.yaml is
# empty again and 0.76.0-r1 is pristine upstream built on go1.27.2 (v0.75.0
# raised go.mod to `go 1.27.0`). Upstream 0.75/0.76 also changed client/server
# mode itself: cryptographic assets now travel with the blob and the result
# (aquasecurity/trivy#11141), and packages keep their modularity label, build
# info and installed files across the RPC (aquasecurity/trivy#11188), which
# fixes silent false negatives on RHEL-family modular packages and Red Hat
# SBOM properties that only client/server mode lost. Both add RPC fields, so
# mixing releases is unsupported; the report's `Trivy.Server` block the
# adapter verifies is unchanged in shape. VERSION moves 1.4.2 -> 1.5.0, a
# minor, because the trivy server release the adapter requires changes.
#
# Pinned by DIGEST, not tag: that repo rebuilds weekly to pick up RPM errata,
# so its tags are moving targets by design. buildx selects the TARGETPLATFORM
# variant from the multi-arch index automatically, so the arm64 build gets the
# arm64 trivy and the amd64 build gets amd64 — both are published.
# This digest is the manifest-list digest of tag 0.76.0-r3 (note: no leading
# `v` on the published tag — the publish job renders it with
# docker/metadata-action `type=semver,pattern={{version}}`).
#
# Nothing couples the backend to a specific trivy version: the 0.71.2 strings
# in backend/scanner-adapter tests are mock/stub fixtures, and the adapter
# probes the real version at startup (ProbeVersion). The upstream source tag
# DID move this time — the bundled binary now reports `Version: 0.76.0` — and
# nothing in the backend reads that string, so no test or config follows it.
#
# This digest is the manifest-list digest of tag 0.76.0-r2 (artifact-keeper/
# trivy#19, tag v0.76.0-r2, published 2026-10-21; verified with `skopeo
# inspect --raw`). The bundled binary is unchanged upstream v0.76.0
# (531360e5) rebuilt on go1.27.3; `go version -m` on it reports go1.27.3.
#
# 0.76.0-r1 -> 0.76.0-r2 (#4852): the pinned-base-image watch reported HIGH
# CVE-2026-111943 in the bundled trivy (stdlib v1.27.2, fixed in 1.27.3). A
# stdlib advisory has no module to override, so the fix in artifact-keeper/
# trivy is a GO_VERSION bump alone (trivy#19); nothing else moved there. It
# was merged, tagged v0.76.0-r2, and this FROM repoints to the published
# digest. docker/scanner-adapter/VERSION moves 1.5.0 -> 1.6.0 with it, because
# exact versions are never republished (scripts/ci/check-version-pin-bump.sh).
#
# 0.76.0-r2 -> 0.76.0-r3 (#5041): Docker Publish's gate reported HIGH
# CVE-2026-116587 (GHSA-mgcc-cww5-fp2q, go-jose v4.1.5, fixed in 4.1.6) in
# the bundled trivy on main from 79e52871 (run 40671050571). No Trivy release
# carries the fix (v0.76.0 and v0.76.1 pin v4.1.5); upstream main made the
# bump in aquasecurity/trivy#11488, so artifact-keeper/trivy added a go-jose
# override on top of the unchanged v0.76.0 source (trivy#20), tagged
# v0.76.0-r3, and this FROM repoints to that published manifest-list digest
# (verified with `skopeo inspect --raw`). docker/scanner-adapter/VERSION moves
# 1.6.0 -> 1.6.1 with it.
FROM ghcr.io/artifact-keeper/trivy@sha256:e324a1cc4ad525ed0a39d623a277a12cd138fd8ee2a88f60f776ae5a40b5b0ce AS trivy

# ---------- Stage 3: minimal runtime ----------
# alpine 3.20 reached EOL; 3.24 is the current stable with active security
# errata. The stage is named so CI can cache-bust it (`no-cache-filters`),
# forcing the apk layer to re-resolve current package errata on every publish
# instead of reusing a stale cached layer.
FROM alpine:3.24 AS runtime

# Refresh the whole base FIRST, then install the runtime deps.
#
# The cache-bust above is necessary but was not sufficient, and #3612 is the
# proof. `apk add` only resolves the packages NAMED on its command line; it
# leaves an already-installed package alone as long as the installed version
# still satisfies the dependency constraint. libcrypto3/libssl3 are not named
# here — they arrive inside the `alpine:3.24` base layer itself — so no amount
# of cache-busting an `apk add` line could ever move them. The layer re-ran on
# every publish exactly as designed and still shipped whatever openssl the
# base image happened to be baked with.
#
# What that shipped: Docker Publish on main went red on 2026-09-01 with
# CVE-2026-14456 (HIGH, openssl unbounded memory growth in the QUIC server)
# against libcrypto3/libssl3 3.5.7-r0, the version in the current alpine:3.24
# layer, fixed in 3.5.8-r0 and available in the v3.24/main repo at the time of
# the failure. Both bundled Go binaries — /usr/local/bin/trivy and
# /usr/local/bin/scanner-adapter — scanned CLEAN in that same run. The finding
# was entirely base-OS, so neither the artifact-keeper/trivy digest below nor
# the GO_MIN_PATCH floor above had anything to do with it, and re-pinning
# either would have been motion without a fix.
#
# `apk upgrade --no-cache` rebuilds the base against current errata on every
# image build; the targeted `add --upgrade` keeps the install set explicit and
# pulls those three forward too. This is the same two-step
# docker/Dockerfile.backend.alpine has used since #2391 — that image was
# already immune to this class, and the asymmetry was the whole bug. Keep the
# two files in step: an errata mechanism that only one of two Alpine runtimes
# has is a gap waiting for the next advisory.
#
# NOTE: /.trivyignore is not an option for this class and says so explicitly —
# base OS package CVEs are "deliberately NOT suppressed" there, and the bar for
# any entry is "no fixed version we can BUILD AGAINST exists". A fixed apk
# existed in the distro repo, so this is a rebuild, not a suppression.
#
# ca-certificates: TLS to the trivy vuln-DB registry / HTTPS registries.
# git + rpm: trivy uses them for certain package/source scanners.
RUN apk upgrade --no-cache \
    && apk add --no-cache --upgrade ca-certificates git rpm \
    && adduser -D -u 1001 scanner \
    && mkdir -p /home/scanner/.cache/trivy \
    && chown -R scanner:scanner /home/scanner

COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
# Apache-2.0 §4(a)/(b): the trivy binary we ship is built from upstream source
# with a documented dependency override, so the licence, NOTICE, build info and
# the modification record must travel with it. They are assembled in the
# artifact-keeper/trivy image; copy them through rather than leaving a modified
# Apache-2.0 binary in the runtime with no accompanying notice.
COPY --from=trivy /licenses/trivy /licenses/trivy
COPY --from=build /out/scanner-adapter /usr/local/bin/scanner-adapter

# DB-download resilience (#2167): the trivy vuln-DB pull defaults to the
# anonymous, rate-limited mirror.gcr.io/aquasecurity/trivy-db endpoint, which
# made the release-gate scanner-efficacy check flaky. The adapter now retries
# the download with exponential backoff (SCANNER_TRIVY_DB_UPDATE_RETRIES, default
# 3). To eliminate the public mirror entirely, set SCANNER_TRIVY_DB_REPOSITORY
# (chart / release-gate deploy) to an AK-controlled trivy-db mirror, e.g.
# ghcr.io/artifact-keeper/trivy-db — trivy accepts a comma-separated fallback
# list. No default repository is baked in here so the image works out of the box
# against the public mirror; the mirror is an infra opt-in.
ENV SCANNER_ADAPTER_ADDR=:8080 \
    SCANNER_TRIVY_PATH=/usr/local/bin/trivy \
    SCANNER_TRIVY_CACHE_DIR=/home/scanner/.cache/trivy

USER 1001
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/scanner-adapter"]

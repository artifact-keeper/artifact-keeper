# syntax=docker/dockerfile:1

# Versions for this image, declared once. RUST_VERSION must match
# rust-toolchain.toml's `channel` (#3551) - see the note in Dockerfile.backend.
#
# The rust base tag couples both: the alpine suffix on the official `rust` image
# records which Alpine that Rust release was BUILT against, so not every
# (rust, alpine) pair is published. Confirm the pair exists before bumping
# either ARG:
#   docker manifest inspect rust:${RUST_VERSION}-alpine${ALPINE_VERSION}
ARG ALPINE_VERSION=3.24
ARG RUST_VERSION=1.98

# ---------- Base: Rust toolchain on Alpine ----------
FROM rust:${RUST_VERSION}-alpine${ALPINE_VERSION} AS rust-alpine-base
RUN apk add --no-cache \
    build-base pkgconfig perl openssl-dev openssl-libs-static \
    zlib-dev zlib-static xz-dev xz-static \
    bzip2-dev bzip2-static protobuf-dev curl
RUN cargo install cargo-chef --locked

# ---------- Stage 1: Plan dependencies ----------
FROM rust-alpine-base AS planner
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
RUN cargo chef prepare --recipe-path recipe.json

# ---------- Stage 2: Build dependencies (cached) ----------
FROM rust-alpine-base AS deps
WORKDIR /app
COPY --from=planner /app/recipe.json recipe.json
ENV SQLX_OFFLINE=true
ARG CARGO_FEATURES=""
RUN FEATURES="vendored-openssl"; \
    if [ -n "$CARGO_FEATURES" ]; then FEATURES="$FEATURES,$CARGO_FEATURES"; fi && \
    cargo chef cook --release --features "$FEATURES" --recipe-path recipe.json

# ---------- Stage 3: Build binary ----------
FROM rust-alpine-base AS builder
WORKDIR /app
COPY --from=deps /app/target target
COPY --from=deps /usr/local/cargo/registry /usr/local/cargo/registry
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY backend ./backend
ARG GIT_SHA=unknown
ARG CARGO_FEATURES=""
ARG APP_VERSION=""
ENV SQLX_OFFLINE=true
ENV GIT_SHA=${GIT_SHA}
RUN if [ -n "${APP_VERSION}" ]; then \
      CLEAN_VERSION=$(echo "${APP_VERSION}" | sed 's/^v//'); \
      sed -i "s/^version = \".*\"/version = \"${CLEAN_VERSION}\"/" Cargo.toml; \
    fi && \
    FEATURES="vendored-openssl"; \
    if [ -n "$CARGO_FEATURES" ]; then FEATURES="$FEATURES,$CARGO_FEATURES"; fi && \
    cargo build --release --features "$FEATURES" --bin artifact-keeper

# ---------- Stage 4: Build the grype scanner CLI from source ----------
# The trivy CLI is intentionally NOT bundled in the runtime image. The backend
# drives Trivy in server mode against the trivy sidecar (TRIVY_URL) and falls
# back to the pure-HTTP Twirp endpoint (`scan_with_trivy_http`) when the CLI is
# absent, so the in-image binary is dead weight. Dropping it removes the trivy
# binary's HIGH-severity Go-dependency CVEs and image size with no functional
# loss. See issue #1544.
#
# Grype is BUILT FROM SOURCE at the pinned upstream tag (#3352) rather than
# copied out of ghcr.io/anchore/grype, because a Go STDLIB CVE in that image's
# binary is a property of the toolchain Anchore compiled with and cannot be
# bumped away. See the fuller note in Dockerfile.backend for the six HIGH
# findings that blocked publishing, and for why GO_MIN_PATCH tracks the newest
# patch of the minor the FROM line names (go1.27.1 since #3655).
#
# This stage is kept BYTE-FOR-BYTE equivalent to the UBI image's, ARG values
# included, even though the alpine build and its Trivy gate are currently
# suspended in docker-publish.yml. The two files pinning grype independently is
# exactly the drift shape CLAUDE.md calls out from #2126/#2059, and this file's
# comment had already drifted from its own FROM once before (it claimed
# v0.115.0 while the pin was v0.116.0). Change both together; the guard in
# backend/src/config.rs fails the build if they disagree.
#
# github.com/docker/docker v28.5.2 (CVE-2026-34040) is a dependency rather than
# the toolchain and stays suppressed in /.trivyignore — see Dockerfile.backend
# for why no override version exists to point at. Still true at v0.118.0 (#3655) and
# at v0.120.1 (#3698): the pin is unchanged and the override still fails to
# resolve.
#
# The golang.org/x/mod override #3465 added here is GONE at #3655: grype
# v0.118.0 pins x/mod v0.40.0 itself, so the tag bump replaced it.
#
# google.golang.org/grpc WAS overridden here from #3655 to #3698 (CVE-2026-84304,
# CVE-2026-84445). The v0.118.0 -> v0.120.1 bump at #3698 retired it: v0.120.1
# pins grpc v1.83.2 itself, and the same tag brings golang.org/x/crypto v0.57.0,
# which carries the CVE-2026-56855 / CVE-2026-78662 fixes. What remains is the
# golang.org/x/net override (re-based on v0.120.1's v0.59.0) and an x/crypto
# floor asserted on the compiled binary. The full justification lives in
# Dockerfile.backend — read it there rather than duplicating a second copy
# that can drift.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS grype-bin
ARG TARGETOS
ARG TARGETARCH
ARG GRYPE_VERSION=0.120.1
ARG GRYPE_COMMIT=6f8d854af29d3a3086b11a84afa51554a2a245fe
ARG GO_MIN_PATCH=1.27.3
ARG XNET_FROM=v0.59.0
ARG XNET_TO=v0.60.0
ARG GOJOSE_FROM=v4.1.5
ARG GOJOSE_TO=v4.1.6
ARG XCRYPTO_MIN=v0.56.0

RUN apk add --no-cache git ca-certificates

RUN set -eu; \
    have="$(go env GOVERSION | sed 's/^go//')"; \
    oldest="$(printf '%s\n%s\n' "${have}" "${GO_MIN_PATCH}" | sort -V | head -n1)"; \
    if [ "${have}" != "${GO_MIN_PATCH}" ] && [ "${oldest}" != "${GO_MIN_PATCH}" ]; then \
      echo "ERROR: Go toolchain go${have} is older than the required go${GO_MIN_PATCH}." >&2; \
      echo "       Building grype on it would ship known-vulnerable stdlib (#3352)." >&2; \
      exit 1; \
    fi; \
    echo "grype build: go${have} satisfies the go${GO_MIN_PATCH} floor"

WORKDIR /src

RUN set -eu; \
    git clone --depth 1 --branch "v${GRYPE_VERSION}" https://github.com/anchore/grype.git .; \
    actual="$(git rev-parse HEAD)"; \
    if [ "${actual}" != "${GRYPE_COMMIT}" ]; then \
      echo "ERROR: grype v${GRYPE_VERSION} resolved to ${actual}, expected ${GRYPE_COMMIT}" >&2; \
      exit 1; \
    fi

# Dependency override — golang.org/x/net, CVE-2026-78669. See Dockerfile.backend
# for the levers checked, the policy exception, the reachability finding and
# the MVS set (seven modules on v0.118.0; only x/net itself on v0.120.1, #3698).
RUN set -eu; \
    xnet_pin() { sed -n 's|^[[:space:]]*golang\.org/x/net \(v[^ ]*\).*|\1|p' go.mod | head -n1; }; \
    have="$(xnet_pin)"; \
    if [ "${have}" != "${XNET_FROM}" ]; then \
      echo "ERROR: grype v${GRYPE_VERSION} pins golang.org/x/net ${have}, not ${XNET_FROM}." >&2; \
      echo "       This override was written against ${XNET_FROM}. If upstream now" >&2; \
      echo "       ships >= ${XNET_TO}, DELETE the x/net override block in this stage." >&2; \
      echo "       If it moved to some other version, re-review it." >&2; \
      exit 1; \
    fi; \
    cp go.mod /tmp/go.mod.before-xnet; \
    go get "golang.org/x/net@${XNET_TO}"; \
    got="$(xnet_pin)"; \
    if [ "${got}" != "${XNET_TO}" ]; then \
      echo "ERROR: override did not take: go.mod pins golang.org/x/net ${got}." >&2; \
      exit 1; \
    fi; \
    moved="$(git --no-pager diff --no-index --unified=0 /tmp/go.mod.before-xnet go.mod \
             | sed -n 's|^+[[:space:]]*\([^ ]*\) v.*|\1|p' | sort -u | tr '\n' ' ')"; \
    expected="golang.org/x/net "; \
    if [ "${moved}" != "${expected}" ]; then \
      echo "ERROR: go get moved an undeclared set of modules." >&2; \
      echo "       expected: ${expected}" >&2; \
      echo "       actual:   ${moved}" >&2; \
      echo "       Re-review the x/net override and update the declared set." >&2; \
      exit 1; \
    fi; \
    go mod verify; \
    echo "grype build: override applied — golang.org/x/net ${XNET_FROM} -> ${XNET_TO}"

# Dependency override: github.com/go-jose/go-jose/v4, CVE-2026-116587 (#5041).
# See Dockerfile.backend for the levers checked, the upstream bump it follows
# (anchore/grype#3854), the reachability note and the removal condition.
RUN set -eu; \
    jose_pin() { sed -n 's|^[[:space:]]*github\.com/go-jose/go-jose/v4 \(v[^ ]*\).*|\1|p' go.mod | head -n1; }; \
    have="$(jose_pin)"; \
    if [ "${have}" != "${GOJOSE_FROM}" ]; then \
      echo "ERROR: grype v${GRYPE_VERSION} pins github.com/go-jose/go-jose/v4 ${have}, not ${GOJOSE_FROM}." >&2; \
      echo "       This override was written against ${GOJOSE_FROM}. If upstream now" >&2; \
      echo "       ships >= ${GOJOSE_TO}, DELETE the go-jose override block in this stage." >&2; \
      echo "       If it moved to some other version, re-review it." >&2; \
      exit 1; \
    fi; \
    cp go.mod /tmp/go.mod.before-gojose; \
    go get "github.com/go-jose/go-jose/v4@${GOJOSE_TO}"; \
    got="$(jose_pin)"; \
    if [ "${got}" != "${GOJOSE_TO}" ]; then \
      echo "ERROR: override did not take: go.mod pins github.com/go-jose/go-jose/v4 ${got}." >&2; \
      exit 1; \
    fi; \
    moved="$(git --no-pager diff --no-index --unified=0 /tmp/go.mod.before-gojose go.mod \
             | sed -n 's|^+[[:space:]]*\([^ ]*\) v.*|\1|p' | sort -u | tr '\n' ' ')"; \
    expected="github.com/go-jose/go-jose/v4 "; \
    if [ "${moved}" != "${expected}" ]; then \
      echo "ERROR: go get moved an undeclared set of modules." >&2; \
      echo "       expected: ${expected}" >&2; \
      echo "       actual:   ${moved}" >&2; \
      echo "       Re-review the go-jose override and update the declared set." >&2; \
      exit 1; \
    fi; \
    go mod verify; \
    echo "grype build: override applied: github.com/go-jose/go-jose/v4 ${GOJOSE_FROM} -> ${GOJOSE_TO}"

RUN set -eu; \
    build_date="$(TZ=UTC git log -1 --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ)"; \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
      go build -trimpath -o /grype \
        -ldflags "-w -s -extldflags '-static' \
          -X main.version=${GRYPE_VERSION} \
          -X main.gitCommit=${GRYPE_COMMIT} \
          -X main.gitDescription=v${GRYPE_VERSION} \
          -X main.buildDate=${build_date}" \
        ./cmd/grype; \
    install -Dm644 LICENSE /licenses/grype/LICENSE

# Prove the override reached the compiled binary's build info, which is what
# Trivy actually reads, and that x/crypto is at or above the #3698 floor — see
# Dockerfile.backend (#3655, #3698).
RUN set -eu; \
    info="$(go version -m /grype)"; \
    deps="$(printf '%s\n' "${info}" | grep -c '^[[:space:]]*dep[[:space:]]')"; \
    if [ "${deps}" -lt 50 ]; then \
      echo "ERROR: /grype reports only ${deps} dependency records; build info is" >&2; \
      echo "       unreadable or implausible, so the override is unverified." >&2; \
      exit 1; \
    fi; \
    xnet="$(printf '%s\n' "${info}" \
            | sed -n 's|^[[:space:]]*dep[[:space:]]*golang\.org/x/net[[:space:]]*\(v[^[:space:]]*\).*|\1|p' \
            | head -n1)"; \
    if [ "${xnet}" != "${XNET_TO}" ]; then \
      echo "ERROR: compiled grype records golang.org/x/net '${xnet}', want ${XNET_TO}." >&2; \
      echo "       The Trivy gate reads this build info; the override did not ship." >&2; \
      exit 1; \
    fi; \
    xcrypto="$(printf '%s\n' "${info}" \
               | sed -n 's|^[[:space:]]*dep[[:space:]]*golang\.org/x/crypto[[:space:]]*\(v[^[:space:]]*\).*|\1|p' \
               | head -n1)"; \
    lowest="$(printf '%s\n%s\n' "${xcrypto}" "${XCRYPTO_MIN}" | sort -V | head -n1)"; \
    if [ -z "${xcrypto}" ] || { [ "${xcrypto}" != "${XCRYPTO_MIN}" ] && [ "${lowest}" != "${XCRYPTO_MIN}" ]; }; then \
      echo "ERROR: compiled grype records golang.org/x/crypto '${xcrypto}', below ${XCRYPTO_MIN}." >&2; \
      echo "       That re-ships CVE-2026-56855 / CVE-2026-78662 (#3698)." >&2; \
      exit 1; \
    fi; \
    jose="$(printf '%s\n' "${info}" \
            | sed -n 's|^[[:space:]]*dep[[:space:]]*github\.com/go-jose/go-jose/v4[[:space:]]*\(v[^[:space:]]*\).*|\1|p' \
            | head -n1)"; \
    if [ "${jose}" != "${GOJOSE_TO}" ]; then \
      echo "ERROR: compiled grype records github.com/go-jose/go-jose/v4 '${jose}', want ${GOJOSE_TO}." >&2; \
      echo "       The Trivy gate reads this build info; the override did not ship (#5041)." >&2; \
      exit 1; \
    fi; \
    echo "grype build: build info verified: golang.org/x/net ${xnet}, golang.org/x/crypto ${xcrypto}, go-jose ${jose} across ${deps} deps"

# ---------- Stage 4b: Pre-seed the Grype vulnerability DB ----------
# Populates the Grype DB at build time so the image works on egress-restricted
# networks (e.g. ARC runner pods) without a first-scan network fetch from
# grype.anchore.io. See artifact-keeper#1001.
FROM alpine:${ALPINE_VERSION} AS grype-db-seed
RUN apk add --no-cache ca-certificates
COPY --from=grype-bin /grype /usr/local/bin/grype
ENV GRYPE_DB_CACHE_DIR=/grype-db
RUN mkdir -p /grype-db && grype db update && grype db status

# ---------- Stage 5: Alpine runtime ----------
# Named so CI can cache-bust the package-refresh stages (`no-cache-filters`)
# if/when the suspended alpine publish job is re-enabled; see
# docker-publish.yml. Without that, the registry build cache can serve the
# `apk upgrade` layer stale and ship months-old errata (#2391).
FROM alpine:${ALPINE_VERSION} AS runtime

# Refresh the whole base first so the alpine:3.24 layer picks up the latest
# APK security errata, then install the runtime deps (no libssl needed -
# OpenSSL is vendored/static). `apk upgrade --no-cache` rebuilds against
# current errata on every image build; the targeted `add` keeps the install
# set explicit. squashfs-tools provides `unsquashfs`, which the Incus scanner
# runs to extract SquashFS rootfs images (#4469).
RUN apk upgrade --no-cache && \
    apk add --no-cache --upgrade ca-certificates libgcc libstdc++ zlib xz-libs xz curl \
        squashfs-tools

# --- CIS hardening (adapted from CIS Alpine Linux Benchmark) ---

# Non-root user
RUN addgroup -g 1001 artifact && \
    adduser -D -u 1001 -G artifact -h /home/artifact -s /sbin/nologin artifact

# Application directories
RUN mkdir -p /app /data/storage /data/backups /data/plugins \
    /scan-workspace /shared /home/artifact/.cache/grype /home/artifact/.cache/trivy && \
    chown -R 1001:1001 /data /scan-workspace /home/artifact /app /shared

# Disable core dumps (CIS 1.5.1)
RUN mkdir -p /etc/security/limits.d && \
    echo "* hard core 0" > /etc/security/limits.d/50-coredump.conf && \
    echo "ulimit -c 0" > /etc/profile.d/coredump.sh

# Restrictive umask (CIS 5.4.4)
RUN echo "umask 077" > /etc/profile.d/umask.sh

# Remove SUID/SGID binaries (CIS 6.1.13/6.1.14)
RUN find / -perm /6000 -type f -exec chmod a-s {} \; 2>/dev/null || true

# Remove shell access from system accounts (CIS 5.4.2)
RUN sed -i 's|/bin/sh$|/sbin/nologin|g' /etc/passwd || true

# Clean machine-id (regenerated at runtime)
RUN rm -f /etc/machine-id && touch /etc/machine-id && chmod 0444 /etc/machine-id

# Clean caches
RUN rm -rf /var/cache/apk/* /tmp/*

# --- End CIS hardening ---

# Copy the grype scanner CLI (statically linked Go binary). The trivy CLI is
# deliberately omitted; image scans use the trivy sidecar via TRIVY_URL.
COPY --from=grype-bin /grype /usr/local/bin/

# Apache-2.0 §4(a): grype is built from source here, so we distribute the
# binary and the licence has to travel with it (see Dockerfile.backend).
COPY --from=grype-bin /licenses/grype /licenses/grype

# Pre-seeded Grype vulnerability DB (avoids first-scan network fetch)
COPY --from=grype-db-seed --chown=1001:1001 /grype-db /home/artifact/.cache/grype

# Copy application binary
COPY --from=builder /app/target/release/artifact-keeper /usr/local/bin/

WORKDIR /app
USER 1001

# Grype defaults `db.auto-update=true` and `db.validate-age=true`. With those
# defaults, Grype at scan time refuses to use the pre-seeded DB if its build
# timestamp is older than `db.max-allowed-built-age` (5 days) and tries to
# refetch from grype.anchore.io. That fetch fails in network-restricted
# environments and Grype exits 1 with no stderr (because the scanner passes
# `-q`). Disable both knobs so the seeded DB is honored for the full image
# lifetime; refresh the DB by rebuilding the image. See artifact-keeper#1001
# and PR #1002 (commit 23d9743) which added the seed stage.
ENV RUST_LOG=info \
    STORAGE_PATH=/data/storage \
    BACKUP_PATH=/data/backups \
    GRYPE_DB_CACHE_DIR=/home/artifact/.cache/grype \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_DB_VALIDATE_AGE=false \
    GRYPE_CHECK_FOR_APP_UPDATE=false \
    HOST=0.0.0.0 \
    PORT=8080

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["curl", "-sf", "http://localhost:8080/health"]

CMD ["artifact-keeper"]

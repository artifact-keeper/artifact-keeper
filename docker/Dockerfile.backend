# ---------- Base: Rust toolchain on UBI 9 ----------
# syntax=docker/dockerfile:1
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS rust-base

# Build toolchain versions, declared once per image rather than inline.
#
# RUST_VERSION must match rust-toolchain.toml's `channel` (#3551). rustup reads
# that file at build time and it outranks the toolchain installed here, so a
# mismatch does not fail — it silently downloads a second toolchain and builds
# with the file's version, leaving this ARG looking authoritative while being
# dead weight. scripts/ci/check-toolchain-pin.sh does not cover Dockerfiles.
ARG RUST_VERSION=1.98.0
ARG PROTOC_VERSION=36.1

# sha256 of the protoc release assets, per architecture. Fetching over HTTPS
# authenticates the host, not the bytes; these pin the bytes. Refresh both when
# PROTOC_VERSION moves:
#   curl -sL https://github.com/protocolbuffers/protobuf/releases/download/v${V}/protoc-${V}-linux-x86_64.zip | sha256sum
ARG PROTOC_SHA256_X86_64=c4bc672d9d49214dc8cafdceadf4df92182d6ca8e3ec65a56b2d7de5602669b4
ARG PROTOC_SHA256_AARCH64=237a68856edf1bd28b6204bddd0596c1cf46d298bc29c620012540b2e44c73e7

RUN dnf install -y --nodocs \
    gcc gcc-c++ make pkg-config perl-core \
    openssl-devel zlib-devel xz-devel bzip2-devel \
    unzip \
    && dnf clean all && \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  PROTOC_ARCH="linux-x86_64";   PROTOC_SHA256="${PROTOC_SHA256_X86_64}" ;; \
      aarch64) PROTOC_ARCH="linux-aarch_64"; PROTOC_SHA256="${PROTOC_SHA256_AARCH64}" ;; \
      *)       echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    curl --proto '=https' --tlsv1.2 -sSfL "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PROTOC_ARCH}.zip" \
      -o /tmp/protoc.zip && \
    echo "${PROTOC_SHA256}  /tmp/protoc.zip" | sha256sum -c - && \
    unzip -q /tmp/protoc.zip -d /usr/local && rm /tmp/protoc.zip && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} && \
    . "$HOME/.cargo/env" && \
    cargo install cargo-chef --locked
ENV PATH="/root/.cargo/bin:${PATH}"

# ---------- Stage 1: Plan dependencies ----------
FROM rust-base AS planner
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
RUN cargo chef prepare --recipe-path recipe.json

# ---------- Stage 2: Build dependencies (cached) ----------
FROM rust-base AS deps
WORKDIR /app
COPY --from=planner /app/recipe.json recipe.json
ENV SQLX_OFFLINE=true
ARG CARGO_FEATURES=""
RUN if [ -n "$CARGO_FEATURES" ]; then \
      cargo chef cook --release --features "$CARGO_FEATURES" --recipe-path recipe.json; \
    else \
      cargo chef cook --release --recipe-path recipe.json; \
    fi

# ---------- Stage 3: Build binary ----------
FROM rust-base AS builder
WORKDIR /app
COPY --from=deps /app/target target
COPY --from=deps /root/.cargo/registry /root/.cargo/registry
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY backend ./backend
ARG GIT_SHA=unknown
ARG CARGO_FEATURES=""
ARG APP_VERSION=""
ENV SQLX_OFFLINE=true
ENV GIT_SHA=${GIT_SHA}
RUN if [ -n "${APP_VERSION}" ]; then \
      CLEAN_VERSION=$(echo "${APP_VERSION}" | sed 's/^v//'); \
      sed -i "s/^version = \".*\"/version = \"${CLEAN_VERSION}\"/" Cargo.toml; \
    fi && \
    if [ -n "$CARGO_FEATURES" ]; then \
      cargo build --release --features "$CARGO_FEATURES" --bin artifact-keeper; \
    else \
      cargo build --release --bin artifact-keeper; \
    fi

# ---------- Stage 4: Build minimal rootfs ----------
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS rootfs-builder

# Install only essential runtime libraries into a clean rootfs.
# --refresh forces fresh repo metadata and the follow-up `upgrade -y` pulls
# the latest RHEL 9 z-stream security errata for every installed package
# (curl-minimal/libcurl, glibc*, tar, openssl-libs, xz, xz-libs,
# zlib, zstd) that the install step alone may miss when the metadata cache is
# stale. This guarantees the rootfs is rebuilt against current errata on every
# image build. The reposdir override is required on the upgrade step because
# once the installroot has a populated /etc, dnf reads repos from inside it
# (which is empty) instead of falling back to the host's /etc/yum.repos.d.
#
# NOTE on residual base-OS CVEs: `upgrade -y` can only pull a *fixed* package
# once Red Hat ships errata for it. Trivy currently reports MEDIUM CVEs in
# these UBI 9.8 packages that Red Hat has marked "Affected" or "Will not fix"
# (no fixed RPM exists yet) — those cannot be cleared here and are reported by
# CI with `ignore-unfixed: true`, so they do not produce code-scanning alerts.
# When Red Hat publishes the errata, the next rebuild picks the fixes up
# automatically with no Dockerfile change. See the linked hardening issue.
RUN mkdir -p /mnt/rootfs && \
    dnf install --installroot /mnt/rootfs --releasever 9 --refresh \
        --setopt=reposdir=/etc/yum.repos.d/ \
        --setopt install_weak_deps=0 --nodocs -y \
        glibc-minimal-langpack \
        ca-certificates \
        openssl-libs \
        zlib \
        xz-libs \
        xz \
        curl-minimal \
        tar \
        gzip \
        zstd \
    && dnf --installroot /mnt/rootfs --releasever 9 \
        --setopt=reposdir=/etc/yum.repos.d/ upgrade -y \
    && dnf --installroot /mnt/rootfs clean all \
    && rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/* /mnt/rootfs/tmp/*

# Create non-root user and required directories in the rootfs
RUN echo 'artifact:x:1001:0:Artifact Keeper:/home/artifact:/sbin/nologin' >> /mnt/rootfs/etc/passwd && \
    echo 'artifact:x:1001:' >> /mnt/rootfs/etc/group && \
    mkdir -p /mnt/rootfs/app \
             /mnt/rootfs/data/storage \
             /mnt/rootfs/data/backups \
             /mnt/rootfs/data/plugins \
             /mnt/rootfs/scan-workspace \
             /mnt/rootfs/shared \
             /mnt/rootfs/home/artifact/.cache/grype \
             /mnt/rootfs/home/artifact/.cache/trivy \
             /mnt/rootfs/usr/local/bin && \
    chown -R 1001:0 /mnt/rootfs/data /mnt/rootfs/scan-workspace \
                     /mnt/rootfs/home/artifact /mnt/rootfs/app \
                     /mnt/rootfs/shared

# ---------- STIG hardening (applicable subset for ubi-micro) ----------
# Derived from DISA STIG controls applied in registry.access.redhat.com/ubi9/ubi-stig

# Crypto policy: FIPS-grade defaults for OpenSSL
RUN if [ -f /mnt/rootfs/etc/pki/tls/openssl.cnf ]; then \
      echo -e "\n[algorithm_sect]\ndefault_properties = fips=yes" >> /mnt/rootfs/etc/pki/tls/openssl.cnf; \
    fi

# Disable core dumps (xccdf_org.ssgproject.content_rule_disable_users_coredumps)
RUN mkdir -p /mnt/rootfs/etc/security/limits.d && \
    echo "* hard core 0" > /mnt/rootfs/etc/security/limits.d/50-coredump.conf

# Max concurrent login sessions (xccdf_org.ssgproject.content_rule_accounts_max_concurrent_login_sessions)
RUN echo "* hard maxlogins 10" > /mnt/rootfs/etc/security/limits.d/50-maxlogins.conf

# Ensure no empty passwords (xccdf_org.ssgproject.content_rule_no_empty_passwords)
RUN sed -i 's/\bnullok\b//g' /mnt/rootfs/etc/pam.d/* 2>/dev/null || true

# Restrictive umask (xccdf_org.ssgproject.content_rule_accounts_umask_etc_login_defs)
RUN if [ -f /mnt/rootfs/etc/login.defs ]; then \
      sed -i 's/^UMASK.*/UMASK\t\t077/' /mnt/rootfs/etc/login.defs; \
    fi

# Clean machine-id (regenerated at runtime)
RUN rm -f /mnt/rootfs/etc/machine-id && \
    touch /mnt/rootfs/etc/machine-id && \
    chmod 0444 /mnt/rootfs/etc/machine-id

# Ensure GPG checking for packages (xccdf_org.ssgproject.content_rule_ensure_gpgcheck_local_packages)
RUN if [ -f /mnt/rootfs/etc/dnf/dnf.conf ]; then \
      sed -i 's/^localpkg_gpgcheck.*/localpkg_gpgcheck=1/' /mnt/rootfs/etc/dnf/dnf.conf || \
      echo "localpkg_gpgcheck=1" >> /mnt/rootfs/etc/dnf/dnf.conf; \
    fi

# Remove any leftover cache/tmp artifacts
RUN rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/* /mnt/rootfs/tmp/*

# Strip residual setuid/setgid bits (shadow-utils chage/gpasswd/newgrp etc. are
# pulled transitively and are never used by a non-root, no-login container) and
# drop interpreters/shells the runtime does not need. The CMD (`artifact-keeper`)
# and the curl healthcheck do not invoke bash/gawk/sed; jq is referenced only in
# code comments and never spawned. Removing them shrinks attack surface and
# clears jq's MEDIUM-CVE load. /bin/sh (coreutils-supplied) is intentionally
# left in place.
RUN find /mnt/rootfs -xdev -perm /6000 -type f -exec chmod a-s {} + && \
    rm -f /mnt/rootfs/usr/bin/bash \
          /mnt/rootfs/usr/bin/gawk \
          /mnt/rootfs/usr/bin/sed \
          /mnt/rootfs/usr/bin/bashbug*

# ---------- Stage 5: Build the grype scanner CLI from source ----------
# The trivy CLI is intentionally NOT bundled in the runtime image. Container
# image scans go through a Harbor scanner-adapter over HTTP (TRIVY_ADAPTER_URL,
# #2088); the fs/incus scanners drive the trivy sidecar in server mode
# (TRIVY_URL). Neither needs an in-image binary. Dropping it removes the trivy
# binary's HIGH-severity Go-dependency CVEs and ~150 MB of image size with no
# functional loss. See issues #1544 and #2088.
#
# Grype is BUILT FROM SOURCE at the pinned upstream tag (#3352), the same
# treatment #3123 gave trivy. It is NOT copied out of ghcr.io/anchore/grype
# any more, and the two are not interchangeable: that image's binary is
# compiled with whatever Go toolchain Anchore's release ran on, and a Go
# STDLIB advisory against it is unfixable by us. Bumping the grype tag does
# not help, because a stdlib CVE is a property of the compiler, not of grype
# — v0.117.0 was the current release and was itself built on go1.26.3.
#
# That is not hypothetical. `Security Scan` in docker-publish.yml failed on
# every run on main and on release/1.7.x with six HIGH stdlib findings against
# usr/local/bin/grype (CVE-2026-33818 encoding/asn1, -56853 net/http, -56858
# html/template, -56859 encoding/xml, -56860 net/url, -56862 crypto/tls), all
# fixed in go1.26.6. No images published from either branch, blocking both a
# v1.7.5 security tag and v1.8.0. Rebuilding on go1.26.6 clears those six plus
# the five older stdlib CVEs .trivyignore was suppressing (-27145, -39821,
# -39822, -42504, -46600): 12 HIGH+fixed findings against the binary drop to 1.
#
# The upstream SOURCE tag is unchanged, so this is a repackaging, not a fork:
# `grype --version` still prints exactly `grype 0.118.0` (GrypeScanner parses
# that, and #3287 composes it with the CVE-DB build date into
# `scanner_version`), `grype version` still reports GitCommit/GitDescription
# for the upstream tag, and `Supported DB Schema` is still 6, so the DB seeded
# in stage 5b below still loads. The one field that moves is GoVersion, which
# is the entire point.
#
# History worth keeping: v0.116.0 -> v0.117.0 was bumped for #3307
# (CVE-2026-71556 HIGH, go-git v5.19.1 -> v5.19.2, plus grpc-go 1.80.0 ->
# 1.82.1 and x/text 0.39.0 -> 0.40.0). Nothing regressed to cause that —
# v0.116.0 scanned clean when it was pinned and went red days later when the
# advisory was published against a dependency it already shipped. A clean scan
# is a statement about a moment, not a property of a pin, which is why this
# stage is listed in `no-cache-filters` and rebuilt on every publish.
#
# v0.117.0 -> v0.118.0 is #3655, which is the same story told twice about two
# different modules. The bump RETIRES the x/mod override this stage carried
# (v0.118.0's own go.mod pins x/mod v0.40.0, so lever 1 finally reached it),
# and in the same breath it fails to reach CVE-2026-84304 (HIGH,
# google.golang.org/grpc, fixed in v1.83.1) because v0.118.0 pins grpc
# v1.83.0 — one patch short. A bump and an override in one change, which is why
# the override block below is now about grpc and not about x/mod.
#
# Still NOT fixed by this stage: github.com/docker/docker v28.5.2
# (CVE-2026-34040 HIGH, fixed in 29.3.1) is a DEPENDENCY, not the toolchain,
# and stays suppressed in /.trivyignore. Overriding it was tried and does not
# work: `go mod edit -require=github.com/docker/docker@v29.3.1+incompatible`
# fails module resolution with "unknown revision v29.3.1", so unlike the
# artifact-keeper/trivy overrides there is no version to point at. Suppress
# when there is no fix; rebuild when the fix is a toolchain away.
# Re-tried on the v0.118.0 tree (2026-09-03, #3655): the pin is unchanged at
# v28.5.2+incompatible and `go mod edit -require=...@v29.3.1+incompatible`
# still fails with "unknown revision v29.3.1", so those .trivyignore entries
# stay exactly as they are. Retry again on the next grype bump.
#
# Fixed by this stage as of #3655: google.golang.org/grpc. See the override
# block below the clone. Overriding a module is the third lever this stage has
# needed — bump the tag (#3307, #3655), rebuild on a newer toolchain (#3352),
# override a module (#3465, now #3655) — and the only one that makes our build
# differ from upstream's, so it carries more machinery than the other two.
#
# The golang.org/x/mod override #3465 added here is GONE as of #3655, and that
# is the override life cycle working rather than an accident: v0.118.0 ships
# x/mod v0.40.0 itself, so the override became a duplicate of a shipped release
# — "strictly worse than the bump it imitates", in its own words — and the
# staleness guard it carried is what stopped the build until it was deleted.
# The grpc block below carries the same guard for the same reason.
#
# Build on $BUILDPLATFORM and cross-compile to $TARGETARCH (same pattern as
# Dockerfile.scanner-adapter) so the multi-arch build does not run the Go
# compiler under emulation. The output is still a TARGETARCH binary, exactly
# as the multi-arch upstream image used to supply.
#
# GO_MIN_PATCH is a hard floor asserted below, not a comment. The FROM line
# floats — `golang:1.27-alpine` resolves to the newest 1.27.x, which is what
# you want for a security rebuild — and the floor means a mirror lagging behind
# fails the build loudly instead of silently shipping a vulnerable stdlib.
# Raise it when a new Go stdlib advisory lands; that one-line bump replaces
# what used to be a .trivyignore entry.
#
# The floor moves 1.26.6 -> 1.27.1 at #3655 because it had stopped guarding
# anything. #3579 moved this stage from `golang:1.26` to `golang:1.27-alpine`
# but left the floor on the 1.26 line, and the check is a `sort -V`: every
# 1.27.x sorts above 1.26.6, so no lagging mirror could fail it. go1.27.1
# (2026-09-01) is the newest 1.27 patch and is what the image serves today —
# `go env GOVERSION` prints go1.27.1, echoed by the check below. It is the 1.27
# half of the same paired security release as go1.26.8, and it supersedes the
# go1.26.6 stdlib fixes #3352 floored on (go1.26.6 is 2026-08-13; go1.27.0 is
# 2026-08-19). Keep the floor on the newest patch of whatever minor the FROM
# line names, or this check goes inert again.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS grype-bin
ARG TARGETOS
ARG TARGETARCH
ARG GRYPE_VERSION=0.118.0
ARG GRYPE_COMMIT=756eb9a24f7beeafb6871a24e943e8a3ae210695
ARG GO_MIN_PATCH=1.27.1
# The single declared divergence from upstream grype at this tag. See the
# override block below the clone for the justification and removal condition.
ARG GRPC_FROM=v1.83.0
ARG GRPC_TO=v1.83.1

RUN apk add --no-cache git ca-certificates

RUN set -eu; \
    have="$(go env GOVERSION | sed 's/^go//')"; \
    oldest="$(printf '%s\n%s\n' "${have}" "${GO_MIN_PATCH}" | sort -V | head -n1)"; \
    if [ "${have}" != "${GO_MIN_PATCH}" ] && [ "${oldest}" != "${GO_MIN_PATCH}" ]; then \
      echo "ERROR: Go toolchain go${have} is older than the required go${GO_MIN_PATCH}." >&2; \
      echo "       Building grype on it would ship known-vulnerable stdlib (#3352)." >&2; \
      exit 1; \
    fi; \
    echo "grype build: go${have} satisfies the go${GO_MIN_PATCH} floor"

WORKDIR /src

# Clone the pinned TAG and verify it resolves to the pinned COMMIT: a tag is
# mutable, a commit is not, so this is what makes the pin a supply-chain
# statement rather than a naming convention. Module downloads still go through
# the Go module proxy and are checksum-verified against go.sum.
RUN set -eu; \
    git clone --depth 1 --branch "v${GRYPE_VERSION}" https://github.com/anchore/grype.git .; \
    actual="$(git rev-parse HEAD)"; \
    if [ "${actual}" != "${GRYPE_COMMIT}" ]; then \
      echo "ERROR: grype v${GRYPE_VERSION} resolved to ${actual}, expected ${GRYPE_COMMIT}" >&2; \
      exit 1; \
    fi

# ---- Dependency override: google.golang.org/grpc ${GRPC_FROM} -> ${GRPC_TO} (#3655)
#
# CVE-2026-84304 (HIGH, fixed in google.golang.org/grpc v1.83.1) is reported
# against `usr/local/bin/grype` and is what the Docker Publish `Security Scan`
# is failing on today — Release Preflight reads NOT READY on main because of
# this single finding. v0.117.0 shipped grpc v1.82.1 and v0.118.0 ships
# v1.83.0; both are below the fix.
#
# THIS IS AN OVERRIDE, NOT A BUMP, and that distinction is the whole point.
# The three levers this stage has, in order of preference:
#   1. bump GRYPE_VERSION to a release that carries the fix  (#3307, #3655)
#   2. rebuild on a newer Go toolchain, for a stdlib CVE     (#3352)
#   3. override a module version ourselves                   (here)
# Lever 1 was tried FIRST and is the rest of this change: v0.118.0 (2026-08-27)
# is the newest anchore/grype release, it is the tag this stage now builds, and
# taking it retired the x/mod override that used to occupy this block. It still
# does not reach grpc — v0.118.0's go.mod pins v1.83.0, one patch short. Lever 2
# does not apply either: grpc is a module in grype's dependency graph, not the
# standard library, so GO_MIN_PATCH cannot touch it. Only lever 3 is left.
#
# The policy this block inherits from the sibling artifact-keeper/trivy repo
# (see #3465, whose x/mod block this replaces) is: override only when a HIGH
# finding WITH an available fix is gating the image, only after lever 1 has been
# checked against the RELEASE and not just `main`, and only when upstream has
# already made the same bump. Check the release, every time:
#   gh api repos/anchore/grype/releases --jq '.[0].tag_name'
#   git show <tag>:go.mod | grep google.golang.org/grpc
# All three hold here, which is the difference from #3465 — that override went
# one step beyond the policy and said so, because upstream had not made the
# x/mod bump anywhere. This one they have: anchore/grype `main` carries grpc
# v1.83.1 as of 0f37e38 (2026-09-02), "chore(deps): bump google.golang.org/grpc
# from 1.83.0 to 1.83.1", anchore/grype#3686 — merged, but after v0.118.0 was
# cut, so no release carries it yet. This pulls a merged upstream commit forward
# by one release cycle; it does not invent a pin.
#
# REACHABILITY, honestly stated — and it is the OPPOSITE of the x/mod case this
# block replaces. Those advisories were scoped to golang.org/x/mod/sumdb, which
# grype does not link, so that override cleared a finding that was an artifact
# of Trivy reading Go binaries at module granularity. grpc IS linked into
# cmd/grype. Measured on the v0.118.0 tree (2026-09-03): `go mod why
# google.golang.org/grpc` answers grype/internal/file -> hashicorp/go-getter ->
# cloud.google.com/go/storage -> google.golang.org/grpc, and
# `go list -deps ./cmd/grype` links ~40 grpc packages including the client,
# balancer and transport stack. So this is a fixable HIGH in code the shipped
# binary really contains, not a bookkeeping finding.
#
# REMOVAL CONDITION: delete this block, and the GRPC_FROM/GRPC_TO ARGs, when
# GRYPE_VERSION is moved to the first grype release whose go.mod pins
# google.golang.org/grpc >= v1.83.1:
#   git show <tag>:go.mod | grep google.golang.org/grpc
# You do not have to remember: the guard below asserts that the pinned source
# still requires ${GRPC_FROM} and FAILS THE BUILD when it does not, so the tag
# bump that makes this block redundant is also what stops the build until it is
# deleted. Staleness is caught mechanically, the way the trivy repo's
# apply-overrides.sh catches it — and it demonstrably works: that is exactly how
# the x/mod block that stood here reached its own end.
#
# `go get` rather than `go mod edit -require` or a `replace` directive, for two
# reasons. (a) go.sum stays verifiable and complete: `go get` resolves the new
# requirement through MVS over the real module graph, fetches every module the
# resolution moves through the proxy, and writes their checksum-database-
# verified hashes into go.sum in the same step. `go mod edit -require` is a
# textual edit that writes nothing to go.sum and skips MVS entirely, leaving
# go.mod internally inconsistent until a `go mod tidy` re-does the work properly
# anyway — and tidy costs a full test-dependency download for no change here.
# (b) a `replace` arrow records the ORIGINAL version in the binary's build info,
# so a scan and any SBOM we publish would still read v1.83.0 and report a CVE
# the binary no longer carries; `go get` records the real upgraded version.
#
# MVS consequences are part of the override, not a surprise — and this time
# there are almost none. The x/mod override dragged x/tools, x/crypto, x/net and
# x/text along with it and had to declare all five. Selecting grpc v1.83.1 moves
# EXACTLY ONE module: it is a patch inside the same minor and requires nothing
# newer than v1.83.0 already did (measured on the v0.118.0 tree, 2026-09-03:
# `go get` reports one upgrade and the go.mod diff is one line). The assertion
# below declares that single-module set, so if a future resolution ever moves
# more, the build fails rather than shipping an undeclared divergence.
RUN set -eu; \
    grpc_pin() { sed -n 's|^[[:space:]]*google\.golang\.org/grpc \(v[^ ]*\).*|\1|p' go.mod | head -n1; }; \
    have="$(grpc_pin)"; \
    if [ "${have}" != "${GRPC_FROM}" ]; then \
      echo "ERROR: grype v${GRYPE_VERSION} pins google.golang.org/grpc ${have}, not ${GRPC_FROM}." >&2; \
      echo "       This override was written against ${GRPC_FROM}. If upstream now" >&2; \
      echo "       ships >= ${GRPC_TO}, DELETE the override block in this stage." >&2; \
      echo "       If it moved to some other version, re-review it. See #3655." >&2; \
      exit 1; \
    fi; \
    go get "google.golang.org/grpc@${GRPC_TO}"; \
    got="$(grpc_pin)"; \
    if [ "${got}" != "${GRPC_TO}" ]; then \
      echo "ERROR: override did not take: go.mod pins google.golang.org/grpc ${got}." >&2; \
      exit 1; \
    fi; \
    moved="$(git --no-pager diff --unified=0 go.mod \
             | sed -n 's|^+[[:space:]]*\([^ ]*\) v.*|\1|p' | sort -u | tr '\n' ' ')"; \
    expected="google.golang.org/grpc "; \
    if [ "${moved}" != "${expected}" ]; then \
      echo "ERROR: go get moved an undeclared set of modules." >&2; \
      echo "       expected: ${expected}" >&2; \
      echo "       actual:   ${moved}" >&2; \
      echo "       Re-review the override and update the declared set (#3655)." >&2; \
      exit 1; \
    fi; \
    go mod verify; \
    echo "grype build: override applied — google.golang.org/grpc ${GRPC_FROM} -> ${GRPC_TO}"

# ldflags mirror .goreleaser.yaml at this tag so the built binary reports the
# same identity upstream's release does. buildDate is the commit timestamp
# rather than "now": a wall-clock date would make every rebuild produce a
# different binary and defeat layer caching, and nothing in AK reads it
# (GrypeScanner only parses `grype --version`).
RUN set -eu; \
    build_date="$(TZ=UTC git log -1 --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ)"; \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
      go build -trimpath -o /grype \
        -ldflags "-w -s -extldflags '-static' \
          -X main.version=${GRYPE_VERSION} \
          -X main.gitCommit=${GRYPE_COMMIT} \
          -X main.gitDescription=v${GRYPE_VERSION} \
          -X main.buildDate=${build_date}" \
        ./cmd/grype; \
    install -Dm644 LICENSE /licenses/grype/LICENSE

# Prove the override reached the artifact, not just the source tree. An
# override that resolves in go.mod but does not end up in the compiled binary's
# Go build info fixes nothing: the build info is exactly what Trivy reads, so
# it is what the gate will see. The dep-record count is a plausibility check in
# the same spirit as the trivy repo's assert-buildinfo.sh — without it this
# step would happily report "verified" against a binary whose build info it
# failed to parse at all.
RUN set -eu; \
    info="$(go version -m /grype)"; \
    deps="$(printf '%s\n' "${info}" | grep -c '^[[:space:]]*dep[[:space:]]')"; \
    if [ "${deps}" -lt 50 ]; then \
      echo "ERROR: /grype reports only ${deps} dependency records; build info is" >&2; \
      echo "       unreadable or implausible, so the override is unverified." >&2; \
      exit 1; \
    fi; \
    recorded="$(printf '%s\n' "${info}" \
                | sed -n 's|^[[:space:]]*dep[[:space:]]*google\.golang\.org/grpc[[:space:]]*\(v[^[:space:]]*\).*|\1|p' \
                | head -n1)"; \
    if [ "${recorded}" != "${GRPC_TO}" ]; then \
      echo "ERROR: compiled grype records google.golang.org/grpc '${recorded}', want ${GRPC_TO}." >&2; \
      echo "       The Trivy gate reads this build info; the override did not ship (#3655)." >&2; \
      exit 1; \
    fi; \
    echo "grype build: build info verified — google.golang.org/grpc ${recorded} across ${deps} deps"

# ---------- Stage 5b: Pre-seed the Grype vulnerability DB ----------
# Populates the Grype DB at build time so the image works on egress-restricted
# networks (e.g. ARC runner pods) without a first-scan network fetch from
# grype.anchore.io. See artifact-keeper#1001.
#
# Uses the GHCR mirror (maintained by .github/workflows/mirror-images.yml) to
# avoid Docker Hub anonymous-pull rate limits that intermittently break CI.
FROM ghcr.io/artifact-keeper/ci-mirror/alpine:3.24 AS grype-db-seed
RUN apk add --no-cache ca-certificates
COPY --from=grype-bin /grype /usr/local/bin/grype
ENV GRYPE_DB_CACHE_DIR=/grype-db
RUN mkdir -p /grype-db && grype db update && grype db status

# ---------- Stage 6: UBI 9 Micro runtime ----------
# Named so CI can cache-bust the package-refresh stages (`no-cache-filters`);
# see docker-publish.yml. Without that, the registry build cache can serve the
# rootfs-builder `dnf upgrade` layer stale and ship months-old errata (#2391).
FROM registry.access.redhat.com/ubi9/ubi-micro:9.8 AS runtime

# Copy minimal rootfs (glibc, openssl, ca-certs, curl, user/group, dirs)
COPY --from=rootfs-builder /mnt/rootfs /

# Copy the grype scanner CLI (local SBOM/vuln scans). The trivy CLI is
# deliberately omitted; image scans use the trivy sidecar via TRIVY_URL.
COPY --from=grype-bin /grype /usr/local/bin/

# Apache-2.0 §4(a): grype is now built from source here rather than copied out
# of an upstream image, so we are the ones distributing the binary and the
# licence has to travel with it. Same arrangement the scanner-adapter uses for
# its self-built trivy (/licenses/trivy).
COPY --from=grype-bin /licenses/grype /licenses/grype

# Pre-seeded Grype vulnerability DB (avoids first-scan network fetch)
COPY --from=grype-db-seed --chown=1001:0 /grype-db /home/artifact/.cache/grype

# Copy application binary
COPY --from=builder /app/target/release/artifact-keeper /usr/local/bin/

# Remove the bash shell that the ubi-micro BASE layer ships (the rootfs-builder
# strip only affects the copied rootfs, not files already present in the base).
# On ubi-micro `/bin/sh` and `/usr/bin/sh` are symlinks to bash, so dropping
# bash removes the only interactive shell. Nothing at runtime needs it: the
# binary spawns its subprocesses (tar/chmod/grype) directly via Command::new
# (no `sh -c`), CMD is exec-form `["artifact-keeper"]`, and the HEALTHCHECK is
# exec-form curl. Done with the real coreutils `rm` (exec-form RUN) so it does
# not depend on the shell being deleted. See issue #1544.
RUN ["/usr/bin/rm", "-f", \
     "/usr/bin/bash", "/bin/bash", \
     "/usr/bin/sh", "/bin/sh", \
     "/usr/bin/bashbug", "/usr/bin/bashbug-64"]

WORKDIR /app
USER 1001

# Grype defaults `db.auto-update=true` and `db.validate-age=true`. With those
# defaults, Grype at scan time checks the pre-seeded DB's build timestamp; if
# it is older than `db.max-allowed-built-age` (5 days), Grype refuses to use
# it and tries to download a fresh copy from grype.anchore.io. In the
# network-restricted environments PR #1002 (#1001) was meant to fix (ARC
# runner pods, release-gate jobs), that fetch fails and Grype exits 1 with
# no stderr (because the scanner invocation passes `-q`). We disable both
# knobs so the seeded DB is honored for the full image lifetime; the DB is
# refreshed by rebuilding the image, not at runtime. See artifact-keeper#1001
# and PR #1002 (commit 23d9743) which added the seed stage.
ENV RUST_LOG=info \
    DATABASE_URL=set-database-url-at-runtime \
    STORAGE_PATH=/data/storage \
    BACKUP_PATH=/data/backups \
    GRYPE_DB_CACHE_DIR=/home/artifact/.cache/grype \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_DB_VALIDATE_AGE=false \
    GRYPE_CHECK_FOR_APP_UPDATE=false \
    HOST=0.0.0.0 \
    PORT=8080

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["curl", "-sf", "http://localhost:8080/health"]

CMD ["artifact-keeper"]

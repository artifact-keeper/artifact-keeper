# Builds the next ak-vm-runner golden image (#6072). Running VMs keep the
# image they booted from; new VMs use the new one.
[Unit]
Description=ak-vm-runner: build a new golden VM image
Documentation=https://github.com/artifact-keeper/artifact-keeper/blob/main/docs/ci/vm-runners.md
Wants=libvirtd.service
After=network-online.target libvirtd.service

[Service]
Type=oneshot
User=akvm
Group=akvm
SupplementaryGroups=libvirt
EnvironmentFile=/etc/ak-vm-runner/config.env
ExecStart=/opt/ak-vm-runner/ak-vm-runner build-image
TimeoutStartSec=3600
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ak-vm-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

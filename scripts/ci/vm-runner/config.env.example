# /etc/ak-vm-runner/config.env (mode 0640 root:akvm). Read by both units.
# Every variable has a default in ak-vm-runner; set only what differs.

# GitHub: organization-level JIT runners in this runner group. Jobs reach a
# VM only with `runs-on: ak-vm` (or another label listed here).
AKVM_ORG=artifact-keeper
AKVM_RUNNER_GROUP_ID=1
AKVM_LABELS=ak-vm
# File holding a token that may call POST /orgs/{org}/actions/runners/generate-jitconfig
# and DELETE /orgs/{org}/actions/runners/{id} (admin:org, or a GitHub App
# with organization_self_hosted_runners: write). Mode 0640 root:akvm.
AKVM_TOKEN_FILE=/etc/ak-vm-runner/github-token

# Pool size and per-VM shape. machine-akvm.slice's MemoryLimit must hold
# AKVM_VM_COUNT * (AKVM_VM_MEMORY_MIB + 1 GiB qemu overhead) + 1 GiB; the
# controller starts no VM that does not fit (it reads the limit at runtime).
# Default: one 8 vCPU / 14 GiB VM in a 16G slice. The 4 GiB image-build VM
# does not fit beside it, so build-image drains and waits for the job VM.
# Lowering the count or changing the shape rolls the IDLE VMs at once
# (reasons scale_down, stale_shape); a VM running a job keeps going.
AKVM_VM_COUNT=1
AKVM_VM_VCPUS=8
AKVM_VM_MEMORY_MIB=14336
AKVM_VM_DISK_GB=80

# Host guards: no new VM while the state dir's filesystem has less than this
# much free (kubelet evicts pods below 20% on nodefs) or while MemAvailable
# is below the VM's memory plus this reserve.
AKVM_MIN_FREE_PCT=35
# Below this, idle and paused VMs are destroyed (a VM running a job is kept).
AKVM_CRIT_FREE_PCT=25
AKVM_MIN_HOST_AVAIL_MIB=24576

# Lifetimes (seconds): no runner_start within BOOT_TIMEOUT -> destroyed; idle
# (no job) for IDLE_RECYCLE -> registration removed and VM replaced; any VM
# older than MAX_VM is destroyed even mid-job.
AKVM_BOOT_TIMEOUT=600
AKVM_IDLE_RECYCLE_SECONDS=14400
AKVM_MAX_VM_SECONDS=28800
# How long build-image waits for room in the slice before it gives up.
AKVM_IMAGE_WAIT_SECONDS=28800

# Optional read-only cache disk (raw image) attached to every VM as
# /dev/vdb. Only the operator writes it; see docs/ci/vm-runners.md.
AKVM_CACHE_IMAGE=

# Golden image inputs (pinned).
AKVM_BASE_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
AKVM_BASE_IMAGE_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
AKVM_RUNNER_VERSION=2.338.2
AKVM_RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

AKVM_STATE_DIR=/home/ak-vm-runner

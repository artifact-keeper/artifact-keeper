  "query": "\n        SELECT id, repository_id, storage_key, size_bytes, checksum_sha256\n        FROM artifacts\n        WHERE repository_id = ANY($1::uuid[])\n          AND is_deleted = false\n          AND LOWER(name) = $2\n          AND version = $3\n        LIMIT 1\n        ",
